# Copy to .env.local and fill in. Never commit .env.local.
# Gemini (Google AI Studio, free tier) — server-side only, no NEXT_PUBLIC_ prefix
GEMINI_API_KEY=
GEMINI_MODEL=

# Clerk (development keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (publishable/anon key only; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
